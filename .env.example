# ==============================================================================
# Discovrd - Environment Variables Template (.env.example)
# ==============================================================================
# Discovrd is a 100% on-device iOS application. It does NOT require a .env file
# or third-party API keys at runtime. Apple Music authentication is handled
# natively on-device using Apple's MusicKit framework.
#
# The variables below are optional placeholders for automated CI/CD pipelines
# or command-line signing workflows (e.g., Fastlane or xcodebuild).
# ==============================================================================

# Apple Developer Team ID (found at developer.apple.com/account)
APPLE_TEAM_ID="YOUR_TEAM_ID"

# Bundle Identifier matching your App ID with the MusicKit capability enabled
PRODUCT_BUNDLE_IDENTIFIER="com.example.Discovrd"
